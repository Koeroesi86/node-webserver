{
  "name": "node-webserver-workspace",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage && node tools/dist/scripts/coverage-report.js",
    "coverage:merge": "node tools/dist/scripts/merge-coverage.js",
    "test:integration": "pnpm -r --if-present test:integration",
    "start": "pnpm --filter @koeroesi86/node-webserver start",
    "build": "pnpm -r --if-present build",
    "generate-version": "pnpm --filter @koeroesi86/tools generate-version",
    "load-test": "pnpm build && node tools/dist/scripts/load-test.js",
    "lint": "eslint --ext .ts --cache --cache-strategy content --cache-location .cache/eslint/ .",
    "fallow": "fallow",
    "fallow:ci": "fallow --config .fallowrc.ci.jsonc",
    "quality": "pnpm test:coverage && pnpm coverage:merge && pnpm fallow:ci"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.36.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fallow": "3.31.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
