{
  "name": "node-webserver-workspace",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "start": "pnpm --filter @koeroesi86/node-webserver start",
    "build": "pnpm -r --if-present build",
    "generate-version": "pnpm --filter @koeroesi86/tools generate-version",
    "load-test": "pnpm build && node tools/dist/scripts/load-test.js",
    "lint": "eslint --ext .ts --cache --cache-strategy content --cache-location .cache/eslint/ ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.36.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.4",
    "typescript": "^5.9.3"
  }
}
