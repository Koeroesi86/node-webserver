{
  "name": "node-webserver-workspace",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage && node tools/dist/scripts/coverage-report.js",
    "coverage:merge": "node tools/dist/scripts/merge-coverage.js",
    "test:integration": "pnpm -r --if-present test:integration",
    "start": "pnpm --filter @koeroesi86/node-webserver start",
    "build": "pnpm -r --if-present build",
    "generate-version": "pnpm --filter @koeroesi86/tools generate-version",
    "load-test": "pnpm build && node tools/dist/scripts/load-test.js",
    "lint": "eslint --cache --cache-strategy content --cache-location .cache/eslint/ .",
    "fallow": "fallow",
    "fallow:ci": "fallow --config .fallowrc.ci.jsonc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "quality": "pnpm test:coverage && pnpm coverage:merge && pnpm fallow:ci"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.7",
    "fallow": "3.34.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  }
}
