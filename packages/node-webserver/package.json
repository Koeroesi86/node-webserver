{
  "name": "@koeroesi86/node-webserver",
  "version": "1.0.0",
  "description": "A local Lambda implementation",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/scripts/load-test-server.*",
    "!dist/scripts/load-test-env.*",
    "!dist/configuration.load-test.*",
    "examples",
    "logs/.gitkeep",
    "requests/.gitkeep",
    "responses/.gitkeep",
    "tmp/.gitkeep"
  ],
  "author": {
    "name": "Krisztian Korosi",
    "url": "https://github.com/Koeroesi86"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koeroesi86/node-webserver.git",
    "directory": "packages/node-webserver"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "jest",
    "test:integration": "jest -c integration/jest.config.js",
    "start:load-test": "node dist/scripts/load-test-server.js",
    "benchmark:virtual-hosts": "node dist/scripts/benchmark-virtual-hosts.js",
    "start": "nodemon --watch src --ext ts --exec \"npm run build --silent && node dist/scripts/server.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@koeroesi86/node-lambda-invoke": "workspace:*",
    "@koeroesi86/node-worker-express": "workspace:*",
    "@types/express": "^4.17.21",
    "express": "^4.17.3",
    "find-free-port": "^2.0.0",
    "http-proxy": "^1.17.0",
    "moment": "^2.31.0",
    "pidusage": "^4.0.1",
    "vhost": "^3.0.2"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.14",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/pidusage": "^2.0.5",
    "etag": "^1.8.1",
    "jest": "^29.5.0",
    "rimraf": "^6.1.3",
    "mime-types": "^2.1.35",
    "nodemon": "^2.0.15",
    "ts-jest": "^29.0.5",
    "typescript": "^6.0.3"
  }
}
