{
  "name": "@koeroesi86/node-worker",
  "version": "1.0.0",
  "description": "NodeJS implementation of WebWorkers, and a pool of worker processes on it",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pool": {
      "types": "./dist/pool/index.d.ts",
      "default": "./dist/pool/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "pool": [
        "dist/pool/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "jest",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "example": "ts-node src/example/index.ts"
  },
  "keywords": [],
  "author": {
    "name": "Krisztian Korosi",
    "url": "https://github.com/Koeroesi86"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koeroesi86/node-webserver.git",
    "directory": "packages/node-worker"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ]
}
