{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noImplicitAny": false,
    "declaration": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2017",
    "allowJs": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules", "dist"]
}
