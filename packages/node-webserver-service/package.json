{
  "name": "@koeroesi86/node-webserver-service",
  "version": "1.0.0",
  "description": "OS service integration for @koeroesi86/node-webserver",
  "license": "MIT",
  "author": {
    "name": "Krisztian Korosi",
    "url": "https://github.com/Koeroesi86"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koeroesi86/node-webserver.git",
    "directory": "packages/node-webserver-service"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nws-service": "./dist/scripts/manageService.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "jest",
    "service": "node dist/scripts/manageService.js",
    "start": "nodemon --watch src --ext ts --exec \"npm run build --silent && node dist/scripts/start.js\""
  },
  "dependencies": {
    "@koeroesi86/node-webserver": "workspace:*",
    "os-service": "^2.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/os-service": "^2.2.3",
    "jest": "^29.7.0",
    "nodemon": "^2.0.15",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "examples",
    "configuration.example.js",
    ".logs/.gitkeep"
  ]
}
